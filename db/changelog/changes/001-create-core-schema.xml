<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-01-create-users" author="bekodeg">
        <createTable tableName="users">
            <column name="id" type="TEXT"><constraints primaryKey="true" primaryKeyName="pk_users" nullable="false"/></column>
            <column name="name" type="TEXT"><constraints nullable="false"/></column>
            <column name="public_key" type="TEXT"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <rollback><dropTable tableName="users"/></rollback>
    </changeSet>

    <changeSet id="001-02-create-budgets" author="bekodeg">
        <createTable tableName="budgets">
            <column name="id" type="TEXT"><constraints primaryKey="true" primaryKeyName="pk_budgets" nullable="false"/></column>
            <column name="name" type="TEXT"><constraints nullable="false"/></column>
            <column name="base_currency" type="TEXT"><constraints nullable="false"/></column>
            <column name="created_by" type="TEXT"><constraints nullable="false" foreignKeyName="fk_budgets_created_by" referencedTableName="users" referencedColumnNames="id"/></column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <rollback><dropTable tableName="budgets"/></rollback>
    </changeSet>

    <changeSet id="001-03-create-budget-members" author="bekodeg">
        <createTable tableName="budget_members">
            <column name="budget_id" type="TEXT"><constraints primaryKey="true" primaryKeyName="pk_budget_members" nullable="false" foreignKeyName="fk_budget_members_budget" referencedTableName="budgets" referencedColumnNames="id"/></column>
            <column name="user_id" type="TEXT"><constraints primaryKey="true" primaryKeyName="pk_budget_members" nullable="false" foreignKeyName="fk_budget_members_user" referencedTableName="users" referencedColumnNames="id"/></column>
            <column name="role" type="TEXT"><constraints nullable="false"/></column>
            <column name="joined_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
            <column name="revoked_at" type="TIMESTAMP"/>
        </createTable>
        <rollback><dropTable tableName="budget_members"/></rollback>
    </changeSet>

    <changeSet id="001-04-create-categories" author="bekodeg">
        <createTable tableName="categories">
            <column name="id" type="TEXT"><constraints primaryKey="true" primaryKeyName="pk_categories" nullable="false"/></column>
            <column name="budget_id" type="TEXT"><constraints nullable="false" foreignKeyName="fk_categories_budget" referencedTableName="budgets" referencedColumnNames="id"/></column>
            <column name="name" type="TEXT"><constraints nullable="false"/></column>
            <column name="kind" type="TEXT"><constraints nullable="false"/></column>
            <column name="is_archived" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
        <rollback><dropTable tableName="categories"/></rollback>
    </changeSet>

    <changeSet id="001-05-create-accounts" author="bekodeg">
        <createTable tableName="accounts">
            <column name="id" type="TEXT"><constraints primaryKey="true" primaryKeyName="pk_accounts" nullable="false"/></column>
            <column name="budget_id" type="TEXT"><constraints nullable="false" foreignKeyName="fk_accounts_budget" referencedTableName="budgets" referencedColumnNames="id"/></column>
            <column name="name" type="TEXT"><constraints nullable="false"/></column>
            <column name="opening_balance_minor" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="currency" type="TEXT"><constraints nullable="false"/></column>
            <column name="is_archived" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
        <rollback><dropTable tableName="accounts"/></rollback>
    </changeSet>

    <changeSet id="001-06-create-devices" author="bekodeg">
        <createTable tableName="devices">
            <column name="id" type="TEXT"><constraints primaryKey="true" primaryKeyName="pk_devices" nullable="false"/></column>
            <column name="user_id" type="TEXT"><constraints nullable="false" foreignKeyName="fk_devices_user" referencedTableName="users" referencedColumnNames="id"/></column>
            <column name="name" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
            <column name="revoked_at" type="TIMESTAMP"/>
        </createTable>
        <rollback><dropTable tableName="devices"/></rollback>
    </changeSet>

    <changeSet id="001-07-create-receipts" author="bekodeg">
        <createTable tableName="receipts">
            <column name="id" type="TEXT"><constraints primaryKey="true" primaryKeyName="pk_receipts" nullable="false"/></column>
            <column name="budget_id" type="TEXT"><constraints nullable="false" foreignKeyName="fk_receipts_budget" referencedTableName="budgets" referencedColumnNames="id"/></column>
            <column name="raw_qr" type="TEXT"/>
            <column name="image_path" type="TEXT"/>
            <column name="merchant" type="TEXT"/>
            <column name="receipt_time" type="TIMESTAMP"/>
            <column name="total_minor" type="BIGINT"/>
            <column name="parsed_payload" type="TEXT"/>
            <column name="parse_status" type="TEXT" defaultValue="NEW"><constraints nullable="false"/></column>
        </createTable>
        <rollback><dropTable tableName="receipts"/></rollback>
    </changeSet>

    <changeSet id="001-08-create-transactions" author="bekodeg">
        <createTable tableName="transactions">
            <column name="id" type="TEXT"><constraints primaryKey="true" primaryKeyName="pk_transactions" nullable="false"/></column>
            <column name="budget_id" type="TEXT"><constraints nullable="false" foreignKeyName="fk_transactions_budget" referencedTableName="budgets" referencedColumnNames="id"/></column>
            <column name="occurred_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="amount_minor" type="BIGINT"><constraints nullable="false"/></column>
            <column name="currency" type="TEXT"><constraints nullable="false"/></column>
            <column name="type" type="TEXT"><constraints nullable="false"/></column>
            <column name="author_id" type="TEXT"><constraints nullable="false" foreignKeyName="fk_transactions_author" referencedTableName="users" referencedColumnNames="id"/></column>
            <column name="account_id" type="TEXT"><constraints nullable="false" foreignKeyName="fk_transactions_account" referencedTableName="accounts" referencedColumnNames="id"/></column>
            <column name="destination_account_id" type="TEXT"><constraints foreignKeyName="fk_transactions_destination_account" referencedTableName="accounts" referencedColumnNames="id"/></column>
            <column name="description" type="TEXT"/>
            <column name="category_id" type="TEXT"><constraints foreignKeyName="fk_transactions_category" referencedTableName="categories" referencedColumnNames="id"/></column>
            <column name="receipt_id" type="TEXT"><constraints foreignKeyName="fk_transactions_receipt" referencedTableName="receipts" referencedColumnNames="id"/></column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
        <rollback><dropTable tableName="transactions"/></rollback>
    </changeSet>

    <changeSet id="001-09-create-plans" author="bekodeg">
        <createTable tableName="plans">
            <column name="id" type="TEXT"><constraints primaryKey="true" primaryKeyName="pk_plans" nullable="false"/></column>
            <column name="budget_id" type="TEXT"><constraints nullable="false" foreignKeyName="fk_plans_budget" referencedTableName="budgets" referencedColumnNames="id"/></column>
            <column name="month" type="DATE"><constraints nullable="false"/></column>
            <column name="category_id" type="TEXT"><constraints nullable="false" foreignKeyName="fk_plans_category" referencedTableName="categories" referencedColumnNames="id"/></column>
            <column name="planned_amount_minor" type="BIGINT"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <rollback><dropTable tableName="plans"/></rollback>
    </changeSet>

    <changeSet id="001-10-create-sync-operations" author="bekodeg">
        <createTable tableName="sync_operations">
            <column name="op_id" type="TEXT"><constraints primaryKey="true" primaryKeyName="pk_sync_operations" nullable="false"/></column>
            <column name="budget_id" type="TEXT"><constraints nullable="false" foreignKeyName="fk_sync_operations_budget" referencedTableName="budgets" referencedColumnNames="id"/></column>
            <column name="entity_type" type="TEXT"><constraints nullable="false"/></column>
            <column name="entity_id" type="TEXT"><constraints nullable="false"/></column>
            <column name="op_type" type="TEXT"><constraints nullable="false"/></column>
            <column name="patch" type="TEXT"><constraints nullable="false"/></column>
            <column name="author_id" type="TEXT"><constraints nullable="false" foreignKeyName="fk_sync_operations_author" referencedTableName="users" referencedColumnNames="id"/></column>
            <column name="device_id" type="TEXT"><constraints nullable="false" foreignKeyName="fk_sync_operations_device" referencedTableName="devices" referencedColumnNames="id"/></column>
            <column name="logical_clock" type="BIGINT"><constraints nullable="false"/></column>
            <column name="signature" type="BLOB"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <rollback><dropTable tableName="sync_operations"/></rollback>
    </changeSet>

</databaseChangeLog>
