      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"plans\" (\"id\" TEXT NOT NULL, \"budget_id\" TEXT NOT NULL REFERENCES budgets (id) ON DELETE CASCADE, \"month\" INTEGER NOT NULL, \"category_id\" TEXT NOT NULL REFERENCES categories (id), \"planned_amount_minor\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
