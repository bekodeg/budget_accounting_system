  "fixed_sql": [
    {
      "name": "users",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"users\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"public_key\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "budgets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budgets\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"base_currency\" TEXT NOT NULL, \"created_by\" TEXT NOT NULL REFERENCES users (id), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "budget_members",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budget_members\" (\"budget_id\" TEXT NOT NULL REFERENCES budgets (id) ON DELETE CASCADE, \"user_id\" TEXT NOT NULL REFERENCES users (id) ON DELETE CASCADE, \"role\" TEXT NOT NULL, \"joined_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"revoked_at\" INTEGER NULL, PRIMARY KEY (\"budget_id\", \"user_id\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"budget_id\" TEXT NOT NULL REFERENCES budgets (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" TEXT NOT NULL, \"budget_id\" TEXT NOT NULL REFERENCES budgets (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"opening_balance_minor\" INTEGER NOT NULL DEFAULT 0, \"currency\" TEXT NOT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "devices",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"devices\" (\"id\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL REFERENCES users (id) ON DELETE CASCADE, \"name\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"revoked_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "receipts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"receipts\" (\"id\" TEXT NOT NULL, \"budget_id\" TEXT NOT NULL REFERENCES budgets (id) ON DELETE CASCADE, \"raw_qr\" TEXT NULL, \"image_path\" TEXT NULL, \"merchant\" TEXT NULL, \"receipt_time\" INTEGER NULL, \"total_minor\" INTEGER NULL, \"parsed_payload\" TEXT NULL, \"parse_status\" TEXT NOT NULL DEFAULT 'NEW', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" TEXT NOT NULL, \"budget_id\" TEXT NOT NULL REFERENCES budgets (id) ON DELETE CASCADE, \"occurred_at\" INTEGER NOT NULL, \"amount_minor\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"author_id\" TEXT NOT NULL REFERENCES users (id), \"account_id\" TEXT NOT NULL REFERENCES accounts (id), \"destination_account_id\" TEXT NULL REFERENCES accounts (id), \"description\" TEXT NULL, \"category_id\" TEXT NULL REFERENCES categories (id), \"receipt_id\" TEXT NULL UNIQUE REFERENCES receipts (id), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
